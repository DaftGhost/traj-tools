{
  "name": "fine-tuning-traj",
  "version": "2.0.0",
  "description": "航线编辑器 - 基于 Leaflet 的地理轨迹编辑工具",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "build:all": "bun run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext ts,vue",
    "format": "prettier --write src",
    "dev:mbtiles": "bun run scripts/mbtiles-server.ts",
    "dev:worker": "wrangler dev --local",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.3.1",
    "file-saver": "^2.0.5",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.vectorgrid": "^1.3.0",
    "papaparse": "^5.4.1",
    "vue": "^3.5.30",
    "wellknown": "^0.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260205.0",
    "@types/bun": "latest",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.8",
    "@types/papaparse": "^5.3.14",
    "@types/wellknown": "^0.5.8",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6",
    "wrangler": "^4.79.0"
  },
  "private": true
}
