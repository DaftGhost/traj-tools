{
  "name": "fine-tuning-traj",
  "version": "2.0.0",
  "description": "航线编辑器 - 基于 Leaflet 的地理轨迹编辑工具",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:all": "npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src",
    "dev:worker": "wrangler dev --local",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.3.1",
    "file-saver": "^2.0.5",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "papaparse": "^5.4.1",
    "wellknown": "^0.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260205.0",
    "@types/file-saver": "^2.0.7",
    "@types/leaflet": "^1.9.8",
    "@types/papaparse": "^5.3.14",
    "@types/wellknown": "^0.5.8",
    "@typescript-eslint/eslint-plugin": "^6.18.1",
    "@typescript-eslint/parser": "^6.18.1",
    "eslint": "^8.56.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "vitest": "^1.1.0",
    "wrangler": "^4.62.0"
  }
}
