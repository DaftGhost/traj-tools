{
  "env": {
    "browser": true,
    "es2021": true,
    "node": false
  },
  "globals": {
    "L": "readonly",
    "Papa": "readonly",
    "saveAs": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "indent": ["warn", 2],
    "linebreak-style": ["error", "unix"],
    "quotes": ["error", "single"],
    "semi": ["error", "always"],
    "no-unused-vars": ["warn"],
    "no-console": ["off"],
    "no-undef": ["error"],
    "no-inner-declarations": ["off"]
  }
}
